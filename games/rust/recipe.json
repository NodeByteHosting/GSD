{
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-05-30T00:00:00+00:00",
    "name": "Rust",
    "author": "NodeByteHosting",
    "description": "Rust multiplayer server with steamcmd integration and auto-update support.",
    "features": [],
    "docker_images": {
        "ghcr.io/nodebytehosting/games:rust": "ghcr.io/nodebytehosting/games:rust"
    },
    "file_denylist": [],
    "startup": "bash start.sh",
    "config": {
        "files": "{}",
        "startup": "{\n  \"done\": \"Server started successfully\"\n}",
        "log": "{\n  \"custom\": false,\n  \"location\": \"latest.log\"\n}",
        "stop": "^C"
    },
    "scripts": {
        "installation": "#!/bin/bash\nset -e\n\necho \"Installing Rust Server...\"\nmkdir -p /home/container\n\necho \"Downloading Rust server via steamcmd...\"\ncd /home/container\n\n# Check if steamcmd is available, otherwise download it\nif [ ! -f /usr/local/bin/steamcmd ]; then\n    echo \"Installing steamcmd...\"\n    apk add --no-cache curl\n    mkdir -p /home/steam/steamcmd\n    cd /home/steam/steamcmd\n    curl -sqL 'https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz' | tar zxvf -\n    ln -s /home/steam/steamcmd/steamcmd.sh /usr/local/bin/steamcmd\nfi\n\necho \"Fetching latest Rust server build...\"\nsteamcmd +login anonymous +app_update 258550 validate +quit\n\necho \"Rust Server installed!\"\necho \"Set AUTO_UPDATE=1 to automatically update on startup\"\n"
    },
    "variables": [
        {
            "name": "Auto Update",
            "description": "Automatically download latest Rust server binaries on startup",
            "env_variable": "AUTO_UPDATE",
            "default_value": "1",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|in:0,1",
            "field_type": "text"
        },
        {
            "name": "Server Name",
            "description": "Server name displayed in server browser",
            "env_variable": "RUST_SERVER_NAME",
            "default_value": "Rust Server",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:64",
            "field_type": "text"
        },
        {
            "name": "Server Description",
            "description": "Server description shown in browser",
            "env_variable": "RUST_SERVER_DESCRIPTION",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:256",
            "field_type": "text"
        },
        {
            "name": "Server URL",
            "description": "Server website URL",
            "env_variable": "RUST_SERVER_URL",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|url",
            "field_type": "text"
        },
        {
            "name": "World Seed",
            "description": "World seed for deterministic generation (empty for random)",
            "env_variable": "RUST_SERVER_SEED",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|numeric",
            "field_type": "text"
        },
        {
            "name": "World Size",
            "description": "World size in meters (typical: 3500)",
            "env_variable": "RUST_SERVER_WORLDSIZE",
            "default_value": "3500",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:1000,8000",
            "field_type": "text"
        },
        {
            "name": "Max Players",
            "description": "Maximum player slots",
            "env_variable": "RUST_SERVER_MAXPLAYERS",
            "default_value": "100",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:1,500",
            "field_type": "text"
        },
        {
            "name": "Tick Rate",
            "description": "Server tick rate (higher = more responsive, more CPU)",
            "env_variable": "RUST_SERVER_TICKRATE",
            "default_value": "30",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:15,60",
            "field_type": "text"
        },
        {
            "name": "Save Interval",
            "description": "Auto-save interval in seconds",
            "env_variable": "RUST_SERVER_SAVEINTERVAL",
            "default_value": "300",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:60,3600",
            "field_type": "text"
        }
    ]
}
